{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Facility": {
    "TimeZoneId": "Asia/Karachi"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=health_erp_dev;Username=<local-db-user>;Password=<local-db-password>"
  },
  "JwtSettings": {
    "Secret": "<generate-a-random-signing-key-and-store-in-user-secrets>",
    "Issuer": "HealthERP.Api",
    "Audience": "HealthERP.Client",
    "ExpiryMinutes": 120
  },
  "EmailSettings": {
    "FromName": "Health ERP Support",
    "FromAddress": "noreply@example.org",
    "Host": "127.0.0.1",
    "Port": 1025,
    "Username": "",
    "Password": "",
    "EnableSsl": false,
    "FrontendBaseUrl": "http://localhost:4200"
  },
  "DevelopmentSeed": {
    "Enabled": false,
    "AdminEmail": "admin@example.invalid",
    "AdminPassword": "",
    "DoctorEmail": "doctor@example.invalid",
    "DoctorPassword": ""
  }
}
